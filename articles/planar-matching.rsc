 claimed."}],["$","a",null,{"className":"article-material-link","href":"/verification/AIRP-V3ZR-2MYB-U2ZZ/AIRP-V3ZR-2MYB-U2ZZ-v3.1.0-lean-r1.zip","download":true,"children":["Lean verification companion",["$","span",null,{"children":["ZIP · r",1," ↓"]}]]}],["$","div",null,{"className":"article-verification-links","children":[["$","a",null,{"href":"/verification/AIRP-V3ZR-2MYB-U2ZZ/AIRP-V3ZR-2MYB-U2ZZ-v3.1.0-lean-r1.zip.sha256","target":"_blank","rel":"noopener noreferrer","children":"SHA-256 ↗"}],["$","a",null,{"href":"/papers/AIRP-V3ZR-2MYB-U2ZZ/#formalization-title","children":"Verification details ↗"}]]}]]}]]}]]}]
