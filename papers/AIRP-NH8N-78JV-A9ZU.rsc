["$","dt",null,{"children":"Manuscript date"}],["$","dd",null,{"children":["$","time",null,{"dateTime":"2026-09-21","children":"2026-09-21"}]}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Length"}],["$","dd",null,{"children":[15," pages"]}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Type"}],["$","dd",null,{"children":"Research paper"}]]}]]}],["$","a",null,{"className":"paper-read-primary","href":"/papers/AIRP-NH8N-78JV-A9ZU/v1.0.2.pdf","target":"_blank","rel":"noopener noreferrer","aria-label":"Read PDF in a new tab: Sharp low-dimensional comparisons and structural obstructions for Nyström approximation","children":["Read PDF ",["$","span",null,{"children":["v","1.0.2"," ↗"]}]]}],["$","p",null,{"className":"paper-preview-note","children":"Opens in a new tab."}],false]}],["$","div",null,{"className":"paper-reading-body","children":[["$","section",null,{"aria-labelledby":"abstract-title","children":[["$","h2",null,{"id":"abstract-title","children":"Overview"}],[["$","p","For a prescribed positive spectrum, this paper compares the largest possible best-subset Nyström trace error with its volume-sampling mean. It determines the sharp comparison factor in dimension four, gives an exact formula for a family with two repeated eigenvalues, and characterizes equality for two-point precision spectra through equiangular tight frames.",{"children":"For a prescribed positive spectrum, this paper compares the largest possible best-subset Nyström trace error with its volume-sampling mean. It determines the sharp comparison factor in dimension four, gives an exact formula for a family with two repeated eigenvalues, and characterizes equality for two-point precision spectra through equiangular tight frames."}],["$","p","A planar selection inequality gives a sharp regularized formula in codimension two when the dimension is divisible by three. Its limiting consequence forces any dimension-independent comparison constant to be at least 3/2. Further results include a 5/3 comparison in these codimension-two dimensions and a Plücker-based bound for the inverse energy of a best Parseval coordinate basis.",{"children":"A planar selection inequality gives a sharp regularized formula in codimension two when the dimension is divisible by three. Its limiting consequence forces any dimension-independent comparison constant to be at least 3/2. Further results include a 5/3 comparison in these codimension-two dimensions and a Plücker-based bound for the inverse energy of a best Parseval coordinate basis."}]],"$Ld"]}],"$Le",false,"$undefined","$Lf","$L10","$L11","$L12"]}]]}]]}],"$L13"]
