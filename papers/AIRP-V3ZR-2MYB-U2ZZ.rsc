e:["$","section",null,{"className":"paper-scope","aria-labelledby":"scope-title","children":[["$","h2",null,{"id":"scope-title","children":"Scope & limitations"}],["$","p",null,{"children":"The general count requires angular monotonicity; the effective algorithm requires dense rational Fourier input. Its output covers optimal values, not all tied assignments. General arbitrary-mass transportation and three-dimensional asymptotic counts remain open."}]]}]
